{
  "name": "pdm-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline --outDir dist-offline",
    "preview": "vite preview",
    "preview:offline": "vite preview --outDir dist-offline",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "fast-xml-parser": "^5.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
